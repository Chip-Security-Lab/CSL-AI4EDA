# Public repository: documentation, approved images and provided examples.
*
!*/
!*.md
!/.gitignore
!/.gitattributes
!/assets/*.png
!/assets/*.jpg
!/plugins/*/assets/*.png
!/plugins/*/assets/*.jpg
!/plugins/*/assets/*.svg
!/plugins/*/LICENSE*
!/plugins/*/examples/**

# Keep generated environments, local credentials and caches out of examples.
**/.env
**/.env.local
**/.env.production
**/__pycache__/
**/.venv/
**/node_modules/
**/.DS_Store
